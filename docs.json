{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Web Accessibility",
  "colors": {
    "primary": "#166534",
    "light": "#22C55E",
    "dark": "#14532D"
  },
  "background": {
    "colors": {
      "light": "#FFFFFF",
      "dark": "#000000"
    }
  },
  "fonts": {
    "heading": {
      "family": "DM Sans"
    },
    "body": {
      "family": "DM Sans"
    }
  },
  "favicon": "/favicon.png",
  "navigation": {
    "tabs": [
      {
        "tab": "Accessibility Widget",
        "icon": "wheelchair",
        "groups": [
          {
            "group": "Getting started",
            "icon": "rocket",
            "pages": ["index", "accessibility-widget/quickstart"]
          },
          {
            "group": "Customization",
            "icon": "palette",
            "pages": [
              "accessibility-widget/customization/overview",
              "accessibility-widget/customization/colour",
              "accessibility-widget/customization/icon",
              "accessibility-widget/customization/position",
              "accessibility-widget/customization/language"
            ]
          }
        ]
      },
      {
        "tab": "EU Withdrawal Button",
        "icon": "rotate-left",
        "groups": [
          {
            "group": "Getting started",
            "icon": "rocket",
            "pages": [
              "eu-withdrawal-button/overview",
              "eu-withdrawal-button/quickstart",
              "eu-withdrawal-button/customer-experience"
            ]
          },
          {
            "group": "Managing withdrawals",
            "icon": "table-list",
            "pages": [
              "eu-withdrawal-button/managing/dashboard",
              "eu-withdrawal-button/managing/withdrawals-list",
              "eu-withdrawal-button/managing/withdrawal-detail"
            ]
          },
          {
            "group": "Settings",
            "icon": "sliders",
            "pages": [
              "eu-withdrawal-button/settings/overview",
              "eu-withdrawal-button/settings/button-appearance",
              "eu-withdrawal-button/settings/withdrawal-window",
              "eu-withdrawal-button/settings/emails-and-notifications"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Support",
      "href": "mailto:info@clevyre.com"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "perplexity", "mcp", "cursor", "vscode"]
  }
}
